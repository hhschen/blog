---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TriangleAlert, Calendar } from "@lucide/astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

// Define page props
interface Props {
    post: CollectionEntry<"posts">;
}

// Generate article routes
export const getStaticPaths = (async () => {
    const posts = await getCollection("posts");

    return posts.map((post: CollectionEntry<"posts">) => ({
        params: { id: post.id },
        props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const allPosts = (await getCollection("posts")).sort(
    (a, b) =>
        a.data.pubDate.getTime() - b.data.pubDate.getTime() ||
        a.id.localeCompare(b.id),
);

const index = allPosts.findIndex((p) => p.id === post.id);

const previous = index > 0 ? allPosts[index - 1] : undefined;
const next = index >= 0 ? allPosts[index + 1] : undefined;

const randomUrls = allPosts
    .filter((p) => p.id !== post.id)
    .map((p) => `/posts/${p.id}`);

const formatDate = (date: Date) => {
    const months = [
        "Jan.",
        "Feb.",
        "Mar.",
        "Apr.",
        "May",
        "Jun.",
        "Jul.",
        "Aug.",
        "Sep.",
        "Oct.",
        "Nov.",
        "Dec.",
    ];

    return `${months[date.getUTCMonth()]} ${date.getUTCDate()}. ${date.getUTCFullYear()}`;
};
---

<BaseLayout
    title={`${post.data.title} - Probably a Blog.`}
    description={post.data.description}
    type="article"
>
    <!-- Spoiler -->
    {post.data.spoiler && (
        <dialog
            id="spoiler-dialog"
            data-post-id={post.id}
            aria-labelledby="spoiler-title"
            class="fixed inset-0 m-auto w-[90%] max-w-sm
                   rounded-xl border border-line bg-surface
                   p-6 text-center text-ink shadow-2xl
                   backdrop:bg-black/50 backdrop:backdrop-blur-sm"
        >
            <h2
                id="spoiler-title"
                class="flex items-center justify-center gap-2 text-2xl font-bold"
            >
                <TriangleAlert
                    size={28}
                    class="text-accent"
                    aria-hidden="true"
                />
                前方有雷！
            </h2>

            <p class="mt-4 text-sm leading-7 text-muted">
                本篇文章包含重大劇情劇透。
                <br />
                如果還沒看過原作，現在撤退還來得及。
            </p>

            <div class="mt-6 flex justify-center gap-3">
                <a
                    href="/posts"
                    class="rounded-lg border border-line px-4 py-2
                           text-sm hover:bg-hover"
                >
                    先撤退
                </a>

                <button
                    id="spoiler-continue"
                    type="button"
                    class="rounded-lg bg-ink px-4 py-2
                           text-sm text-page hover:opacity-85"
                >
                    繼續閱讀
                </button>
            </div>
        </dialog>
    )}

    <script is:inline>
        const spoilerDialog = document.querySelector("#spoiler-dialog");

        if (spoilerDialog) {
            const key = `spoiler:${spoilerDialog.dataset.postId}`;

            if (sessionStorage.getItem(key) !== "accepted") {
                spoilerDialog.showModal();
            }

            spoilerDialog.addEventListener("cancel", (event) => {
                event.preventDefault();
            });

            document
                .querySelector("#spoiler-continue")
                .addEventListener("click", () => {
                    sessionStorage.setItem(key, "accepted");
                    spoilerDialog.close();
                });
        }
    </script>

    <main class="mx-auto max-w-3xl px-6 pt-16 pb-24 xl:max-w-7xl">
        <div class="grid xl:grid-cols-[minmax(0,1fr)_minmax(0,45rem)_minmax(0,1fr)]">
            <div class="min-w-0 xl:col-start-2">
                <article data-pagefind-body>
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-sm">
                        <span class="text-accent">{post.data.category}</span>

                        <span class="text-muted">·</span>

                        <span class="inline-flex items-center gap-2 text-muted">
                            <Calendar size={18} aria-hidden="true" />

                            <time datetime={post.data.pubDate.toISOString()}>
                                {formatDate(post.data.pubDate)}
                            </time>
                        </span>

                        {post.data.updatedDate &&
                            formatDate(post.data.updatedDate) !==
                                formatDate(post.data.pubDate) && (
                                <>
                                    <span class="text-muted">·</span>

                                    <time
                                        class="text-muted"
                                        datetime={post.data.updatedDate.toISOString()}
                                    >
                                        更新於{" "}
                                        {formatDate(post.data.updatedDate)}
                                    </time>
                                </>
                            )}
                    </div>

                    <h1 class="mt-5 text-4xl font-bold">{post.data.title}</h1>

                    <p class="mt-3 text-sm leading-relaxed opacity-70">
                        {post.data.description}
                    </p>

                    <hr class="my-8 border-0 border-t border-line" />

                    {toc.length >= 2 && (
                        <details class="mb-8 border-b border-line pb-4 xl:hidden">
                            <summary class="cursor-pointer font-medium">
                                文章目錄
                            </summary>

                            <nav aria-label="文章目錄" class="mt-4 space-y-3">
                                {toc.map((h) => (
                                    <a
                                        href={`#${h.slug}`}
                                        class:list={[
                                            "block text-sm text-muted transition-colors hover:text-accent",
                                            h.depth === 3 && "pl-4",
                                        ]}
                                    >
                                        {h.text}
                                    </a>
                                ))}
                            </nav>
                        </details>
                    )}

                    <div
                        class="prose post-content max-w-none
                               [&_h2]:scroll-mt-24
                               [&_h3]:scroll-mt-24"
                    >
                        <Content />
                    </div>
                </article>

                <nav
                    aria-label="文章導覽"
                    class="mt-16 border-t border-line pt-8"
                >
                    <div class="grid gap-6 sm:grid-cols-2">
                        {previous && (
                            <a
                                href={`/posts/${previous.id}`}
                                class="group block"
                            >
                                <span class="text-sm text-muted">← 上一篇</span>

                                <p
                                    class="mt-2 font-semibold transition-colors
                                           group-hover:text-accent"
                                >
                                    {previous.data.title}
                                </p>
                            </a>
                        )}

                        {next && (
                            <a
                                href={`/posts/${next.id}`}
                                class="group block sm:col-start-2 sm:text-right"
                            >
                                <span class="text-sm text-muted">下一篇 →</span>

                                <p
                                    class="mt-2 font-semibold transition-colors
                                           group-hover:text-accent"
                                >
                                    {next.data.title}
                                </p>
                            </a>
                        )}
                    </div>

                    {randomUrls.length > 0 && (
                        <div class="mt-10 text-center">
                            <a
                                id="random-post"
                                href="/posts"
                                data-urls={JSON.stringify(randomUrls)}
                                class="text-sm text-muted transition-colors hover:text-accent"
                            >
                                ? 隨機閱讀一篇文章
                            </a>
                        </div>
                    )}
                </nav>
            </div>

            {toc.length >= 2 && (
                <aside class="hidden xl:col-start-3 xl:block">
                    <nav
                        aria-label="文章目錄"
                        class="sticky top-24 ml-8 max-h-[calc(100vh-8rem)]
                               overflow-y-auto border-l border-line pl-4 pr-2"
                    >
                        <p class="mb-4 text-sm font-semibold">目錄</p>

                        <ul class="space-y-3">
                            {toc.map((h) => (
                                <li class:list={[h.depth === 3 && "pl-3"]}>
                                    <a
                                        href={`#${h.slug}`}
                                        class="block text-sm leading-relaxed
                                               text-muted transition-colors
                                               hover:text-accent"
                                    >
                                        {h.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                </aside>
            )}
        </div>
    </main>
</BaseLayout>

<script>
    document.querySelectorAll(".post-content pre.astro-code").forEach((pre) => {
        const wrapper = document.createElement("div");
        wrapper.className = "relative";

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "code-copy";
        button.textContent = "複製";
        button.setAttribute("aria-label", "複製程式碼");

        button.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(pre.textContent ?? "");
                button.textContent = "已複製 ✓";
                setTimeout(() => (button.textContent = "複製"), 2000);
            } catch {
                button.textContent = "複製失敗";
            }
        });

        wrapper.appendChild(button);
    });

    const randomLink =
        document.querySelector<HTMLAnchorElement>("#random-post");

    randomLink?.addEventListener("click", (event) => {
        if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
        ) {
            return;
        }

        const urls: string[] = JSON.parse(randomLink.dataset.urls ?? "[]");

        if (urls.length === 0) return;

        event.preventDefault();

        const randomIndex = Math.floor(Math.random() * urls.length);
        window.location.assign(urls[randomIndex]);
    });
</script>
