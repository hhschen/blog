---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "katex/dist/katex.min.css";
import "@mirrordown/remd-spoiler/spoiler.css";
import "remark-github-blockquote-alert/alert.css";
interface Props {
    title: string;
    description?: string;
    type?: "website" | "article";
}

const { title, description, type = "website" } = Astro.props;

const metaDescription =
    description ??
    "Probably a Blog.，H2 的個人部落格。記錄物理、科技、ACG，以及一些沒什麼營養的碎碎念。";

const canonicalURL = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : undefined;
---

<html lang="zh-TW">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <!-- RSS Autodiscovery -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Probably a Blog."
            href="/rss.xml"
        />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <title>{title}</title>
        <meta name="description" content={metaDescription} />

        {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}

        <!-- Open Graph -->
        <meta property="og:site_name" content="Probably a Blog." />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:type" content={type} />
        <meta property="og:locale" content="zh_TW" />

        {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}

        <!-- Social -->
        <meta name="twitter:card" content="summary" />

        <!-- theme-toggle -->
        <script is:inline>
            const savedTheme = localStorage.getItem("theme");

            const prefersDark = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;

            const isDark =
                savedTheme === "dark" || (savedTheme === null && prefersDark);

            document.documentElement.classList.toggle("dark", isDark);
        </script>

        <!-- pagefind -->
        <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
        <script
            is:inline
            type="module"
            src="/pagefind/pagefind-component-ui.js"
        ></script>
    </head>

    <body class="flex min-h-screen flex-col">
        <Header />

        <div class="flex-1">
            <slot />
        </div>

        <Footer />
    </body>
</html>
