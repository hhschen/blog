---
import type { CollectionEntry } from "astro:content";

interface Props {
    post: CollectionEntry<"posts">;
    headingTag?: "h2" | "h3";
}

const { post, headingTag = "h2" } = Astro.props;
const Heading = headingTag;
---

<a
    href={`/posts/${post.id}`}
    class="block rounded-xl border border-line bg-surface p-6 hover:bg-hover"
>
    <div class="flex items-center gap-3 text-sm text-muted">
        <span class="text-accent">{post.data.category}</span>

        <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("zh-TW")}
        </time>
    </div>

    <Heading class="mt-3 text-xl font-bold">{post.data.title}</Heading>

    <p class="mt-2 text-sm leading-6 text-muted">{post.data.description}</p>
</a>
